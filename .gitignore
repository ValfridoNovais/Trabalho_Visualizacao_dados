# === Segurança (CRÍTICO) ===
# Bloqueia chaves de API e variáveis de ambiente
.Renviron
.env

# === renv (Gestão de Pacotes) ===
# Ignoramos a biblioteca pesada local, mas mantemos o "renv.lock"
renv/library/
renv/python/
renv/staging/
renv/local/
renv/cellar/
# NOTA: O arquivo "renv.lock" e "renv/activate.R" DEVEM ser commitados.

# === Quarto e Relatórios ===
# Pastas temporárias de build
/.quarto/
/_site/
*_cache/
*_files/
